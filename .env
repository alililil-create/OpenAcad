# 应用配置
APP_NAME=ML Learning Agent System
DEBUG=True

# 服务器
HOST=0.0.0.0
PORT=8000

# ===== 运行模式 =====
# mock: 使用模拟数据（无需API Key，用于演示）
# production: 使用真实AI模型（需要配置API Key）
MODE=production

# 讯飞星火配置 - Spark X2 【新凭证 2026-05-22】
XUNFEI_API_PASSWORD=sLEBXKhyxveRbEJsABXv:BhsQDWQvUEymOgVMHkoo
XUNFEI_APP_ID=d063fe22
XUNFEI_API_KEY=16e377d62e654b5598d6630a8ce0537c
XUNFEI_API_SECRET=Zjc3NTk0OWJlZWI1Y2M5NTRhY2ZjNTYx

# ===== LLM 提供商 =====
# spark: 讯飞星火 / deepseek: DeepSeek / qwen: 通义千问
LLM_PROVIDER=deepseek
LLM_MODEL=ep-20260601002955-t6bkd

# DeepSeek 配置 (火山方舟)
DEEPSEEK_API_KEY=201de072-63c6-4a9a-815a-b96fba3ca0f1
DEEPSEEK_MODEL=ep-20260601002955-t6bkd
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 安全密钥
SECRET_KEY=your-super-secret-key-change-in-production-2024

# CORS
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]

# ===== 数据库配置 =====
# SQLite（开发模式，无需安装数据库）
DB_ENGINE=sqlite
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DATABASE=local_db

# SQLite（备用 - 切换到前一行 DB_ENGINE=sqlite 即可回退）
DATABASE_URL=sqlite+aiosqlite:///./ml_learning.db

# ===== Redis 配置 =====
# Redis（Docker 容器）
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ===== Milvus 向量数据库 =====
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530

# ===== MinIO OSS 配置 =====
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
